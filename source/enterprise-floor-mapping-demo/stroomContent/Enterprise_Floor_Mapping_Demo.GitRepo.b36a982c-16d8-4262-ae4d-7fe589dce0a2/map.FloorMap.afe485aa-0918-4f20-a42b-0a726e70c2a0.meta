  },
  "factsStoreRef" : {
    "type" : "SqlTemporalStore",
    "uuid" : "8de52ae8-337c-4e7f-8222-2cd3fe12019a",
    "name" : "floor_map_facts"
  },
  "eventsStoreRef" : {
    "type" : "FloorMapEventStore",
    "uuid" : "64918035-f346-4a9b-bb62-e864d2ebca53",
    "name" : "floor_map_events"
  },
  "eventsQuery" : "from param('EventStore')\nselect EffectiveTime as \"Effective Time\",\n  Key as \"Entity ID\",\n  jq(Value, '.location') as \"Location\",\n  jq(Value, '.locationRef') as \"Location Ref\",\n  jq(Value, '.type') as \"Type\",\n  jq(Value, '.status') as \"Status\",\n  jq(Value, '.message') as \"Message\"",
  "histogramQuery" : "from param('EventStore')\neval bucket = floorTime(EffectiveTime, param('bucketWidth'))\ngroup by bucket\nsort by bucket\nselect bucket, count()",
  "extentQuery" : "from param('EventStore')\neval allRows = 1\ngroup by allRows\nselect allRows, min(EffectiveTime), max(EffectiveTime)",
  "eventsQueryTimeRange" : {
    "name" : "All time",
    "condition" : "BETWEEN"
  },
  "eventsQueryTablePreferences" : { },
  "valueFormat" : "JSON",
  "valueSchema" : [ {
    "path" : ".type",
