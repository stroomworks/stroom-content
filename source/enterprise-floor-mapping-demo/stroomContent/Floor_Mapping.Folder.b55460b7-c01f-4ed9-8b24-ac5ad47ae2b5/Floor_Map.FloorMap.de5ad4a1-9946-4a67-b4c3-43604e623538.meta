  },
  "eventsStoreRef" : {
    "type" : "PlanB",
    "uuid" : "17e21f76-1fa3-4723-a277-b0ee122e2cc7",
    "name" : "events_planb_store"
  },
  "eventsQuery" : "from param('EventStore')\nselect EffectiveTime as \"Effective Time\",\n  Key as \"Entity ID\",\n  replace(jq(Value, '.location'), '\"', '') as \"Location ID\",\n  jq(Value, '.type') as \"Event Type\",\n  jq(Value, '.status') as \"Status\",\n  jq(Value, '.message') as \"Message\"",
  "eventsQueryTimeRange" : {
    "name" : "All time",
    "condition" : "BETWEEN"
  },
  "eventsQueryTablePreferences" : { },
  "valueFormat" : "JSON",
  "valueSchema" : [ {
    "path" : ".type",
    "role" : "TYPE",
    "displayName" : "Type"
  }, {
    "path" : ".name",
    "role" : "LABEL",
    "displayName" : "Name"
  }, {
    "path" : ".coords",
    "role" : "POSITION",
    "displayName" : "Coords"
  }, {
